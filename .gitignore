# VS Code: keep shared project settings only
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Unity crash reports, build artefacts, caches
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
.gradle/

# OS
.DS_Store
Thumbs.db

# Sonniss #GameAudioGDC recordings: the licence forbids publishing the sound files (modified or not), so they stay
# local. Recreate them with Tools/Audio/prepare_sonniss_audio.sh (see ASSET_LICENSES.md). Kenney (CC0) files are kept.
