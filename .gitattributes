# Normalise line endings for text; Unity YAML assets stay LF on every platform.
* text=auto
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.hlsl text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf

# Large binary assets go to Git LFS. Git LFS is not installed yet: once it is
# (`brew install git-lfs && git lfs install`), uncomment these lines BEFORE committing binary assets.
